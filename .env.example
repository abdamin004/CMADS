# ── CMADS Environment Variables ──────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env

# ── LLM Configuration ───────────────────────────────────
# Provider: "groq" (cloud, fast) or "ollama" (local, free)
LLM_PROVIDER=groq

# Model for agents (reasoning, diagnosis, treatment)
# Groq models: openai/gpt-oss-120b, llama-3.3-70b-versatile, mixtral-8x7b-32768
# Ollama models: gpt-oss:120b, llama3:70b, mixtral:8x7b
LLM_MODEL=openai/gpt-oss-120b

# Model for the LLM-as-Judge evaluator (can be different from agent model)
# Recommended: a smaller/faster model for classification tasks
LLM_EVALUATOR_MODEL=qwen/qwen3-32b

# ── API Keys ────────────────────────────────────────────
# Groq API — required if LLM_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Ollama — no key needed, just set the URL if not default
# OLLAMA_URL=http://localhost:11434

# ── Qdrant Vector DB — required for Treatment Planning ──
# Create a free cluster at https://cloud.qdrant.io
# Then run: python3 -m src.vectordb.setup_qdrant
QDRANT_URL=
QDRANT_API_KEY=

# ── LangSmith Tracing (optional) ────────────────────────
# Create account at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cmads-clinical-pipeline
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
