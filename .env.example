# ── CMADS Environment Variables ──────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env

# ── LLM Provider ────────────────────────────────────────
# Choose ONE provider: groq, openai, anthropic, gemini, ollama
LLM_PROVIDER=groq

# ── Model Names ─────────────────────────────────────────
# Agent model (reasoning, diagnosis, treatment)
LLM_MODEL=openai/gpt-oss-120b

# Evaluator model (LLM-as-Judge — can be smaller/cheaper)
LLM_EVALUATOR_MODEL=qwen/qwen3-32b

# Optional: use a different provider for the evaluator
# LLM_EVALUATOR_PROVIDER=openai

# ── Provider API Keys (set the one matching your provider) ──

# Groq — https://console.groq.com/keys
# Models: openai/gpt-oss-120b, llama-3.3-70b-versatile, mixtral-8x7b-32768, qwen/qwen3-32b
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, o1, o3-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                  # Optional: for Azure, OpenRouter, or local vLLM

# Anthropic — https://console.anthropic.com/settings/keys
# Models: claude-sonnet-4-20250514, claude-haiku-4-20250414
# ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Models: gemini-2.0-flash, gemini-2.5-pro, gemini-1.5-pro
# GOOGLE_API_KEY=

# Ollama — no key needed (local), just ensure server is running
# Models: llama3:70b, mixtral:8x7b, qwen2:72b, gemma2:27b
# OLLAMA_URL=http://localhost:11434

# ── Qdrant Vector DB (Treatment Planning) ───────────────
# Create a free cluster at https://cloud.qdrant.io
# Then run: make setup-qdrant
QDRANT_URL=
QDRANT_API_KEY=

# ── LangSmith Tracing (optional) ────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=cmads-clinical-pipeline
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
