# ── CMADS Environment Variables ──────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env

# ══════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ══════════════════════════════════════════════════════════

# Provider: groq, openai, anthropic, gemini, ollama
LLM_PROVIDER=groq

# Model for agents (reasoning, diagnosis, treatment)
LLM_MODEL=openai/gpt-oss-120b

# Model for the LLM-as-Judge evaluator (can be smaller/cheaper)
LLM_EVALUATOR_MODEL=qwen/qwen3-32b

# Optional: use a different provider for the evaluator
# LLM_EVALUATOR_PROVIDER=openai

# ══════════════════════════════════════════════════════════
# API KEYS (set the one matching your provider)
# ══════════════════════════════════════════════════════════

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=             # Optional: Azure, OpenRouter, vLLM

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Ollama — no key needed, just set URL if not default
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CONTEXT_WINDOW=16384

# ══════════════════════════════════════════════════════════
# VECTOR DATABASE (Treatment Planning)
# ══════════════════════════════════════════════════════════

QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=nice_guidelines
# EMBEDDING_MODEL=FremyCompany/BioLORD-2023

# ══════════════════════════════════════════════════════════
# AGENT TUNING (advanced — defaults work well)
# ══════════════════════════════════════════════════════════

# Diagnostic agent adaptive loop
# DIAGNOSTIC_MAX_ROUNDS=3               # Max self-critique rounds (1-5)
# DIAGNOSTIC_CONFIDENCE_THRESHOLD=75    # Stop when confidence >= this (0-100)

# Timeouts and retries
# AGENT_TIMEOUT=300                     # Max seconds per agent (default: 300 = 5 min)
# LLM_CALL_TIMEOUT=120                  # Warn if a single LLM call exceeds this (seconds)
# LLM_MAX_RETRY_WAIT=10                 # Max seconds between retries (caps exponential backoff)
# DIAGNOSTIC_CONFIDENCE_THRESHOLD=75    # Stop when confidence >= this (0-100)

# ══════════════════════════════════════════════════════════
# DATA PATHS (change if your data is elsewhere)
# ══════════════════════════════════════════════════════════

# GOLD_DIR=data/gold/patient_cases
# MAS_RESULTS_DIR=data/gold/mas_results
# GUIDELINES_DIR=config/guidelines
# DUCKDB_PATH=data/clinical.duckdb

# ══════════════════════════════════════════════════════════
# OBSERVABILITY (optional)
# ══════════════════════════════════════════════════════════

# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=cmads-clinical-pipeline
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
