# ── CMADS Environment Variables ──────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env

# Groq API — required for all LLM calls
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Qdrant Vector DB — required for Treatment Planning agent
# Create a free cluster at https://cloud.qdrant.io
# Then run: python -m src.vectordb.setup_qdrant
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# LangSmith Tracing — optional, for observability
# Create account at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cmads-clinical-pipeline
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
