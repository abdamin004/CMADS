{
  "disease": "End-stage renal disease (disorder)",
  "snomed_code": "46177005",
  "nice_guideline": "NG107 / NG203",
  "nice_title": "Renal replacement therapy and conservative management / CKD assessment and management",
  "source": "NICE NG107 (2018), NG203 (2021, updated 2023)",

  "first_line_treatment": [
    {
      "drug_class": "ACE inhibitor or ARB",
      "examples": ["Ramipril", "Lisinopril", "Losartan", "Irbesartan"],
      "indication": "All CKD/ESRD patients with proteinuria (ACR ≥30)",
      "notes": "Renoprotective. Monitor potassium and creatinine closely"
    },
    {
      "drug_class": "Erythropoiesis-stimulating agent (ESA)",
      "examples": ["Epoetin alfa (Epogen/Eprex)", "Darbepoetin alfa (Aranesp)"],
      "indication": "Anaemia of CKD (Hb <100 g/L and symptomatic)",
      "notes": "Target Hb 100-120 g/L. Check iron stores first"
    },
    {
      "drug_class": "Iron supplementation",
      "examples": ["Ferric carboxymaltose IV", "Iron sucrose IV", "Ferrous sulphate oral"],
      "indication": "Iron deficiency (ferritin <200 or TSAT <20%)",
      "notes": "IV iron preferred in dialysis patients"
    },
    {
      "drug_class": "Phosphate binder",
      "examples": ["Sevelamer", "Lanthanum carbonate", "Calcium acetate"],
      "indication": "Hyperphosphataemia (phosphate >1.5 mmol/L)",
      "notes": "Take with meals. Avoid calcium-based binders if hypercalcaemia"
    },
    {
      "drug_class": "Vitamin D analogue",
      "examples": ["Alfacalcidol", "Calcitriol", "Cholecalciferol"],
      "indication": "Secondary hyperparathyroidism / vitamin D deficiency",
      "notes": "Monitor calcium and PTH"
    }
  ],

  "second_line_treatment": [
    {
      "drug_class": "SGLT2 inhibitor",
      "examples": ["Dapagliflozin"],
      "indication": "CKD with eGFR 20-45 (NICE TA775)",
      "notes": "Slows CKD progression regardless of diabetes status"
    },
    {
      "drug_class": "Calcimimetic",
      "examples": ["Cinacalcet"],
      "indication": "Secondary hyperparathyroidism not controlled by vitamin D",
      "notes": "For dialysis patients"
    },
    {
      "drug_class": "Sodium bicarbonate",
      "examples": ["Sodium bicarbonate 500mg-1g TDS"],
      "indication": "Metabolic acidosis (serum bicarbonate <20 mmol/L)",
      "notes": "Monitor for fluid overload"
    }
  ],

  "renal_replacement_therapy": [
    {
      "type": "Haemodialysis",
      "indication": "eGFR <5-7 or uraemic symptoms",
      "notes": "Usually 3 sessions/week, 4 hours each"
    },
    {
      "type": "Peritoneal dialysis",
      "indication": "Patient choice, residual renal function, lifestyle preference",
      "notes": "Home-based option"
    },
    {
      "type": "Kidney transplant",
      "indication": "Preferred RRT if suitable — pre-emptive or after dialysis",
      "notes": "Best long-term outcomes. Requires immunosuppression"
    },
    {
      "type": "Conservative management",
      "indication": "If patient declines or is unsuitable for RRT",
      "notes": "Focus on symptom management and quality of life"
    }
  ],

  "contraindicated_drugs": [
    {"drug": "NSAIDs", "reason": "Worsen renal function, fluid retention"},
    {"drug": "Metformin if eGFR <30", "reason": "Lactic acidosis risk"},
    {"drug": "High-dose potassium supplements", "reason": "Hyperkalaemia risk"},
    {"drug": "Nephrotoxic antibiotics (Gentamicin) without dose adjustment", "reason": "Accumulation toxicity"}
  ],

  "monitoring": [
    "eGFR and creatinine: every 1-3 months",
    "Potassium: every 1-3 months (risk of hyperkalaemia)",
    "Phosphate, calcium, PTH: every 3-6 months",
    "Haemoglobin and iron studies: every 3 months",
    "Bicarbonate: every 3 months",
    "BP: every visit (target <130/80 with proteinuria)",
    "Fluid status: weight, oedema assessment",
    "Vascular access assessment: if approaching dialysis"
  ],

  "non_pharmacological": [
    "Low protein diet: 0.8-1.0 g/kg/day (pre-dialysis)",
    "Potassium restriction if hyperkalaemia",
    "Phosphate restriction: limit dairy, processed foods",
    "Sodium restriction: <6g salt/day",
    "Fluid restriction if oliguric",
    "Smoking cessation",
    "Exercise as tolerated"
  ]
}
